{
  "manifest_version": 3,
  "name": "VeriFeed",
  "version": "1.0.0",
  "description": "Real-time multimodal deepfake and misinformation checks for the Instagram web feed.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "VeriFeed", "default_popup": "popup.html" }
}
